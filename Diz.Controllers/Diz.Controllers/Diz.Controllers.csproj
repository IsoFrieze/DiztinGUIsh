<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Diz.Core\Diz.Core.csproj" />
      <ProjectReference Include="..\..\Diz.Import\Diz.Import.csproj" />
      <ProjectReference Include="..\..\Diz.LogWriter\Diz.LogWriter.csproj" />
      <!-- The ViewModel assembly, so backend-selectable view interfaces here can name the
           ViewModel they edit (IMarkManyView). This direction only: the ViewModels are
           platform-free and must never reference this project back, so that a backend can
           consume them without dragging the controller layer along. -->
      <ProjectReference Include="..\..\Diz.Ui.ViewModels\Diz.Ui.ViewModels.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="LightInject">
        <Version>6.6.4</Version>
      </PackageReference>
    </ItemGroup>

</Project>
