<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Diz.ViewModels</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Diz.Core\Diz.Core.csproj" />
        <ProjectReference Include="..\Diz.Core.Interfaces\Diz.Core.Interfaces.csproj" />
        <ProjectReference Include="..\Diz.Import\Diz.Import.csproj" />
    </ItemGroup>

    <!--
      This assembly must stay platform-free: it is the one ViewModel layer shared by the
      WinForms, Avalonia, and TUI backends. A '-windows' TFM (or a UI toolkit) here is the
      exact mistake Diz.Ui.Eto made, and it silently makes the assembly unusable on the
      other backends. Fail loudly instead of discovering it at the third backend.
    -->
    <Target Name="AssertDizUiViewModelsStaysPlatformFree" BeforeTargets="Build">
        <Error Condition="'$(TargetFramework)' != '' and $(TargetFramework.Contains('windows'))"
               Text="Diz.Ui.ViewModels must stay platform-free, but TargetFramework is '$(TargetFramework)'. It may never gain a Windows-specific TFM. Platform code belongs in a Diz.Ui.* or Diz.App.* project." />
        <Error Condition="'$(TargetFrameworks)' != '' and $(TargetFrameworks.Contains('windows'))"
               Text="Diz.Ui.ViewModels must stay platform-free, but TargetFrameworks is '$(TargetFrameworks)'. It may never gain a Windows-specific TFM. Platform code belongs in a Diz.Ui.* or Diz.App.* project." />
        <Error Condition="'$(UseWindowsForms)' == 'true' or '$(UseWPF)' == 'true'"
               Text="Diz.Ui.ViewModels must stay platform-free: UseWindowsForms/UseWPF may never be enabled here." />
    </Target>

</Project>
