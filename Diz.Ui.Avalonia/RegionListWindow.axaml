<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Diz.Ui.Avalonia.RegionListWindow"
        x:CompileBindings="False"
        Title="Regions List"
        Width="1280" Height="720"
        MinWidth="700" MinHeight="320"
        FontSize="12">

    <!--
      The Avalonia region editor: a MASTER LIST plus an EDITABLE details pane, over the same
      RegionListViewModel the WinForms grid binds. The two toolkits deliberately differ in
      LAYOUT - WinForms shows all thirteen columns at once, this one shows the eight
      scannable ones and puts the awkward fields (the asset descriptors and their free-form
      JSON) in the pane - while sharing the ViewModel, so the rules, the sort order and the
      commands cannot drift apart.

      ALL EDITING HAPPENS IN THE PANE; the master grid is read-only. The DataGrid's own edit
      pipeline commits a cell's value into the bound object and then tells you about it, whereas
      the ViewModel must validate FIRST and refuse - leaving the typed text on screen and the
      model untouched. Those two are not reconcilable through two-way cell binding, so the pane
      carries purpose-built editors instead and the grid stays a display of the result.

      Sorting is the ViewModel's, not the grid's: CanUserSortColumns is off and each header's
      pointer-press writes SortField/SortDescending and nothing else. Letting the DataGrid sort
      would wrap the row collection in its own ordered view and silently disagree with the order
      the ViewModel hands out - and with the other backend.

      Reflection bindings (x:CompileBindings="False"): the details pane binds through the
      possibly-null SelectedRow, which reflection bindings tolerate without an x:DataType. The
      window's DataContext is the IRegionListViewModel (set in AttachViewModel). The pane's
      EDITORS are not bound at all - they are written from the ViewModel by hand, because a
      binding would fight the caret (see the code-behind's PushText).
    -->

    <Window.Styles>
        <Style Selector="TextBlock.field-label">
            <Setter Property="Foreground" Value="#606060" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- the field whose typed text the model refused: marked where the eye already is (the
             label), not only by a border a focused/hovered text box would repaint anyway. -->
        <Style Selector="TextBlock.field-bad">
            <Setter Property="Foreground" Value="#B00000" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBox.field-editor">
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TextBox.hex">
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
        </Style>
        <Style Selector="TextBox.field-bad">
            <Setter Property="BorderBrush" Value="#B00000" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <!-- toolbar button gaps (WrapPanel has no built-in item spacing in this version) -->
        <Style Selector="WrapPanel#Toolbar > Button">
            <Setter Property="Margin" Value="0,0,6,4" />
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- ============================= top toolbar (wraps: no clipping) ============================= -->
        <WrapPanel x:Name="Toolbar" DockPanel.Dock="Top" Margin="8,8,8,4">
            <Button x:Name="BtnAdd" Tag="add-button" Content="Add Region" Click="BtnAdd_Click" />
            <Button x:Name="BtnDelete" Tag="delete-button" Content="Delete Region" Click="BtnDelete_Click" />
        </WrapPanel>

        <!-- ============================= status bar (bottom-most) ============================= -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#C8C8C8" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" Margin="8,3">
                <TextBlock x:Name="StatusText" Tag="status-text" Grid.Column="0"
                           VerticalAlignment="Center" Foreground="#B00000" TextWrapping="Wrap" />
                <TextBlock x:Name="CountsText" Tag="counts-text" Grid.Column="1"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ============================= problem panel (above the status bar) =============================
             Whole-list problems: relationships BETWEEN regions (crossing file-producing regions,
             overlapping asset regions, a region claiming two output roles, duplicate names), so
             they belong to no single row. DISPLAY-ONLY on purpose: the ViewModel's problem entries
             do not carry the region they are about, so there is nothing to navigate to, and
             offering it would mean guessing from the message text. -->
        <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,2">
            <Button x:Name="ProblemsToggle" Tag="problems-toggle"
                    Content="Problems (0)" Click="ProblemsToggle_Click"
                    HorizontalAlignment="Left" Padding="6,2"
                    Background="Transparent" BorderThickness="0" />
            <ListBox x:Name="ProblemsList" Tag="problems-list"
                     MaxHeight="110" SelectionMode="Single" />
        </StackPanel>

        <!-- ============================= main: master grid | splitter | details ============================= -->
        <Grid ColumnDefinitions="*,4,360" Margin="8,0,8,0">

            <DataGrid x:Name="RegionGrid" Tag="region-grid" Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      SelectionMode="Single"
                      GridLinesVisibility="All"
                      HeadersVisibility="All"
                      RowHeaderWidth="24"
                      SelectionChanged="RegionGrid_SelectionChanged"
                      KeyDown="RegionGrid_KeyDown"
                      LoadingRow="RegionGrid_LoadingRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Start" Width="85"
                                        FontFamily="Consolas, Courier New, monospace"
                                        Binding="{Binding StartText, Mode=OneWay}" />
                    <DataGridTextColumn Header="End" Width="85"
                                        FontFamily="Consolas, Courier New, monospace"
                                        Binding="{Binding EndText, Mode=OneWay}" />
                    <DataGridTextColumn Header="Length" Width="80"
                                        FontFamily="Consolas, Courier New, monospace"
                                        Binding="{Binding LengthText, Mode=OneWay}" />
                    <DataGridTextColumn Header="Region Name" Width="*" MinWidth="140"
                                        Binding="{Binding RegionNameText, Mode=OneWay}" />
                    <DataGridTextColumn Header="Label Context" Width="125"
                                        Binding="{Binding ContextToApplyText, Mode=OneWay}" />
                    <DataGridTextColumn Header="Priority" Width="85"
                                        Binding="{Binding PriorityText, Mode=OneWay}" />
                    <DataGridCheckBoxColumn Header="Separate File" Width="115"
                                            IsReadOnly="True"
                                            Binding="{Binding ExportSeparateFile, Mode=OneWay}" />
                    <DataGridTextColumn Header="Export Type" Width="105"
                                        Binding="{Binding ExportTypeText, Mode=OneWay}" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Background="#DDDDDD" ResizeDirection="Columns" />

            <!-- ===== Region Details pane: the editor for the selected region ===== -->
            <Border Grid.Column="2" BorderBrush="#C8C8C8" BorderThickness="1" Margin="0,2,0,2">
                <ScrollViewer>
                    <Grid x:Name="DetailsPane" Tag="details-pane" Margin="8"
                          ColumnDefinitions="110,*"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                        <TextBlock x:Name="DetailsHeader" Tag="details-header"
                                   Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="Region Details" FontWeight="Bold" Margin="0,0,0,4" />

                        <!-- the message behind the row's bad-row marker, in the pane where the
                             offending field is. The status bar carries the same text; this is the
                             copy the user reads while fixing it. -->
                        <TextBlock x:Name="DetailsError" Tag="details-error"
                                   Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                   Foreground="#B00000" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="{Binding SelectedRow.ErrorText, Mode=OneWay}" />

                        <TextBlock x:Name="LblStart" Tag="details-start-label" Classes="field-label" Grid.Row="2" Grid.Column="0" Text="Start" />
                        <TextBox x:Name="BoxStart" Tag="details-start" Classes="field-editor hex"
                                 Grid.Row="2" Grid.Column="1" />

                        <TextBlock x:Name="LblEnd" Tag="details-end-label" Classes="field-label" Grid.Row="3" Grid.Column="0" Text="End (inclusive)" />
                        <TextBox x:Name="BoxEnd" Tag="details-end" Classes="field-editor hex"
                                 Grid.Row="3" Grid.Column="1" />

                        <TextBlock x:Name="LblLength" Tag="details-length-label" Classes="field-label" Grid.Row="4" Grid.Column="0" Text="Length (hex)" />
                        <TextBox x:Name="BoxLength" Tag="details-length" Classes="field-editor hex"
                                 Grid.Row="4" Grid.Column="1" />

                        <TextBlock x:Name="LblName" Tag="details-name-label" Classes="field-label" Grid.Row="5" Grid.Column="0" Text="Region Name" />
                        <TextBox x:Name="BoxName" Tag="details-name" Classes="field-editor"
                                 Grid.Row="5" Grid.Column="1" />

                        <TextBlock x:Name="LblContext" Tag="details-context-label" Classes="field-label" Grid.Row="6" Grid.Column="0" Text="Label Context" />
                        <TextBox x:Name="BoxContext" Tag="details-context" Classes="field-editor"
                                 Grid.Row="6" Grid.Column="1" />

                        <TextBlock x:Name="LblPriority" Tag="details-priority-label" Classes="field-label" Grid.Row="7" Grid.Column="0" Text="Priority" />
                        <TextBox x:Name="BoxPriority" Tag="details-priority" Classes="field-editor"
                                 Grid.Row="7" Grid.Column="1" />

                        <!-- The two CLOSED-VALUE editors. Their widgets can only ever show a legal
                             value, so a refused edit has no typed text to leave behind: they snap
                             back to what the model holds instead of keeping a bad value on screen. -->
                        <TextBlock x:Name="LblSeparateFile" Tag="details-sepfile-label" Classes="field-label" Grid.Row="8" Grid.Column="0"
                                   Text="Separate File" />
                        <CheckBox x:Name="ChkSeparateFile" Tag="details-sepfile"
                                  Grid.Row="8" Grid.Column="1" Margin="0,2"
                                  Content="Export to its own file" />

                        <TextBlock x:Name="LblExportType" Tag="details-exporttype-label" Classes="field-label" Grid.Row="9" Grid.Column="0"
                                   Text="Export Type" />
                        <ComboBox x:Name="CboExportType" Tag="details-exporttype"
                                  Grid.Row="9" Grid.Column="1" Margin="0,2"
                                  HorizontalAlignment="Stretch" />

                        <!-- Asset fields are shown even when they mean nothing for this row, and
                             greyed instead of hidden: hiding them would make it non-obvious that
                             the feature exists. Nothing clears the stored values while disabled. -->
                        <Border x:Name="AssetFields" Tag="details-asset-fields"
                                Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                                BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,8,0,0" Padding="6">
                            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="Asset fields" FontWeight="Bold" Margin="0,0,0,4" />

                                <TextBlock x:Name="LblAssetType" Tag="details-assettype-label" Classes="field-label" Grid.Row="1" Grid.Column="0"
                                           Text="Asset Type" />
                                <TextBox x:Name="BoxAssetType" Tag="details-assettype" Classes="field-editor"
                                         Grid.Row="1" Grid.Column="1" />

                                <TextBlock x:Name="LblAssetVersion" Tag="details-assetversion-label" Classes="field-label" Grid.Row="2" Grid.Column="0"
                                           Text="Asset Version" />
                                <TextBox x:Name="BoxAssetVersion" Tag="details-assetversion" Classes="field-editor"
                                         Grid.Row="2" Grid.Column="1" />

                                <TextBlock x:Name="LblAssetName" Tag="details-assetname-label" Classes="field-label" Grid.Row="3" Grid.Column="0"
                                           Text="Asset Name" />
                                <TextBox x:Name="BoxAssetName" Tag="details-assetname" Classes="field-editor"
                                         Grid.Row="3" Grid.Column="1" />

                                <TextBlock x:Name="LblAssetOptions" Tag="details-assetoptions-label" Classes="field-label" Grid.Row="4" Grid.Column="0"
                                           Text="Asset Options (JSON)" />
                                <TextBox x:Name="BoxAssetOptions" Tag="details-assetoptions"
                                         Classes="field-editor hex"
                                         Grid.Row="4" Grid.Column="1" />
                            </Grid>
                        </Border>

                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
