<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Diz.Ui.Avalonia.HarshAutoStepWindow"
        x:CompileBindings="False"
        Title="Harsh Auto Step"
        Width="450" Height="400"
        CanResize="False"
        SizeToContent="Manual"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        FontSize="12">

    <!--
      Pick a run of bytes and press Go, and every one of them is decoded as an instruction
      whether or not execution ever reaches it. The warning paragraph above the fields says why
      that is dangerous; it is the same text the WinForms window shows, so the same instructions
      describe either backend.

      The widgets are wired to a HarshAutoStepViewModel by hand in the code-behind
      (HarshAutoStepWindow.axaml.cs) rather than by binding: the three range fields are text
      projections the ViewModel deliberately refuses to rewrite while they hold the caret.

      Field labels, radio captions, the "Disassemble Region" grouping and the button captions
      match the WinForms window.

      Styled like the other Avalonia windows here: compact, FontSize 12, light theme (pinned
      application-wide in DizAvaloniaApp).
    -->

    <Window.Styles>
        <Style Selector="TextBlock.field">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="TextBox.value">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
        </Style>
        <Style Selector="RadioButton">
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Window.Styles>

    <Border Padding="12,10">
        <DockPanel>

            <!-- ============ bottom bar: Cancel | Hex/Dec | Go ============ -->
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,0">
                <Button Grid.Column="0" x:Name="CancelButton" Tag="cancel-button" Content="Cancel"
                        Width="80" IsCancel="True" Click="CancelButton_Click" />
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton x:Name="RadioHex" Tag="radio-hex" GroupName="NumberBase"
                                 Content="Hex" IsCheckedChanged="NumberBase_Changed" />
                    <RadioButton x:Name="RadioDec" Tag="radio-dec" GroupName="NumberBase"
                                 Content="Dec" Margin="0" />
                </StackPanel>
                <Button Grid.Column="2" x:Name="GoButton" Tag="go-button" Content="Go"
                        Width="80" IsDefault="True" Click="GoButton_Click" />
            </Grid>

            <!-- ===== why the range cannot be stepped; the ViewModel's own wording ===== -->
            <TextBlock x:Name="ErrorText" DockPanel.Dock="Bottom" Tag="error-text"
                       Foreground="#B00000" TextWrapping="Wrap" Margin="0,8,0,0" />

            <StackPanel Spacing="6">

                <!-- ===== the warning paragraph, word for word as the WinForms window shows it.
                     Kept as literal line breaks rather than wrapped, so the shape on screen is
                     the same in both backends. ===== -->
                <TextBlock x:Name="WarningText" Tag="warning-text" TextWrapping="Wrap"
                           Text="WARNING: This method of disassembling can cause more&#10;harm than help.&#10;This method will not bother with context or flow of&#10;execution. It will treat the entire specified range as code&#10;and disassemble it one instruction after another.&#10;The M and X flags will still be updated as SEP and REP&#10;instructions are hit, but depending on the arrangement of&#10;the ROM, this may not be enough to stay synched entirely.&#10;Press &quot;Go&quot; at your own risk." />

                <!-- ===== Disassemble Region: the range fields, with the address-space radios
                     beside them and Hex/Dec down in the bottom bar, mirroring the WinForms
                     window so the same instructions describe either backend ===== -->
                <Border BorderBrush="#C8C8C8" BorderThickness="1" CornerRadius="3"
                        Padding="10,8" Margin="0,10,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Disassemble Region" FontWeight="Bold" Margin="0,0,0,4" />

                        <Grid ColumnDefinitions="120,120,*" RowDefinitions="Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="field" Text="Start at Address:" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="StartBox" Tag="start-text" Classes="value"
                                     HorizontalAlignment="Left" Width="110" MaxLength="40"
                                     TextChanged="StartBox_TextChanged" />
                            <RadioButton Grid.Row="0" Grid.Column="2" x:Name="RadioSnes" Tag="radio-snes"
                                         GroupName="AddressSpace" Content="SNES Address"
                                         Margin="12,0,0,0" IsCheckedChanged="AddressSpace_Changed" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="field" Text="Up to and including:" Margin="0,4,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="EndBox" Tag="end-text" Classes="value"
                                     HorizontalAlignment="Left" Width="110" Margin="0,4,0,0" MaxLength="40"
                                     TextChanged="EndBox_TextChanged" />
                            <RadioButton Grid.Row="1" Grid.Column="2" x:Name="RadioPc" Tag="radio-pc"
                                         GroupName="AddressSpace" Content="ROM File Offset"
                                         Margin="12,4,0,0" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="field" Text="Number of Bytes:" Margin="0,4,8,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="CountBox" Tag="count-text" Classes="value"
                                     HorizontalAlignment="Left" Width="110" Margin="0,4,0,0" MaxLength="40"
                                     TextChanged="CountBox_TextChanged" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
