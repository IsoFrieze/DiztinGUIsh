<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GitThisAssemblyMetadata>true</GitThisAssemblyMetadata>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <Nullable>enable</Nullable>
    <RootNamespace>Diz.PowerShell</RootNamespace>
    <!-- PowerShell binary module: copy all dependency dlls into the output dir so
         Import-Module can resolve them (class libs don't copy NuGet deps by default) -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitInfo" Version="3.3.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="LightInject" Version="6.6.4" />
    <PackageReference Include="System.Management.Automation" Version="7.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Diz.Core\Diz.Core.csproj" />
    <!-- needed to OPEN projects, not just export: save-format migrations and the SNES
         data api live here, and project deserialization fails without them -->
    <ProjectReference Include="..\Diz.Cpu.65816\Diz.Cpu.65816.csproj" />
    <ProjectReference Include="..\Diz.LogWriter\Diz.LogWriter.csproj" />
  </ItemGroup>

</Project>
